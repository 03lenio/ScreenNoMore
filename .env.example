# NextDNS
NEXTDNS_API_KEY=<replace_with_your_nextdns_api_key>
NEXTDNS_PROFILE_ID=<replace_with_your_nextdns_profile_id>

# Observing
OBSERVING_INTERVAL=30
OBSERVING_LAST_LOGS_FROM_MINUTES=40
MAX_LOG_PAGES=20

# Generic
LOG_LEVEL=INFO

# Services
SERVICES_CONFIG_PATH=backend/core/service/services/services.json
DATABASE_CONFIG_PATH=/data/screennomore.db

# Health check
HEALTH_FILE=/tmp/screennomore/healthy
HEALTH_MAX_AGE_SECONDS=90
MAX_CONSECUTIVE_FAILURES=10

